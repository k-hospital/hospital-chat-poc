# ─────────────────────────────────────────────────────────────────────
# POC 챗봇 설정 파일 예시.
#   1) 이 파일을 같은 폴더에 ".env" 라는 이름으로 복사한다:  cp .env.example .env
#   2) 서버에서 아래 <...> 부분과 [계정] 항목을 직접 채운다.
#   3) 권한을 제한한다:  chmod 600 .env
# ".env" 는 .gitignore 대상이라 저장소에 올라가지 않는다. 이 예시 파일에는 실제 값을 적지 않는다.
# 값 주위에 따옴표를 붙이지 않는다 (docker compose 의 env_file 은 따옴표를 그대로 값으로 읽는다).
# ─────────────────────────────────────────────────────────────────────

# ── [서버 주소] 필수 ────────────────────────────────────────────────
# 질문 분류에 쓰는 사내 LLM 서버 (OpenAI 호환 API, 주소 끝은 /v1)
# 컨테이너 안에서 접속하므로 localhost 가 아니라 서버의 실제 IP 를 쓴다.
LLM_BASE_URL=http://<LLM 서버 IP>:<포트>/v1
LLM_MODEL=<모델 이름>

# (선택) 위 서버가 실패했을 때 쓸 대체 모델. 쓰지 않으면 두 줄 모두 비운다.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# ── [계정] 직접 설정 (모두 선택) ────────────────────────────────────
# 1) LLM 서버가 API 키를 요구할 때만 채운다. (Authorization: Bearer <키> 로 전달됨)
LLM_API_KEY=

# 2) 챗봇 화면·API 접근용 아이디/비밀번호. 두 값을 모두 채워야 켜지고, 비우면 누구나 접속할 수 있다.
#    (브라우저가 처음 접속할 때 로그인 창을 띄운다. 사내망 http 에서는 평문이므로 운영 전 https 를 검토한다.)
CHATBOT_BASIC_USER=
CHATBOT_BASIC_PASSWORD=

# ── 동작 옵션 (모두 선택) ───────────────────────────────────────────
# 서버에서 열 포트. 이미 쓰는 포트와 겹치면 바꾼다.
CHATPOC_PORT=18080
# 접속을 받을 주소. 같은 서버에서만 쓰려면 127.0.0.1, 사내망에서 접속하려면 0.0.0.0
CHATPOC_BIND=0.0.0.0
# 모델 한 번 호출의 제한 시간(초)
LLM_TIMEOUT_SECONDS=6
# 0 이면 LLM 분류를 끄고 키워드 규칙만 사용
LLM_ENABLED=1

# ── 이미지 빌드용 (서버가 외부 인터넷에 못 나갈 때만) ───────────────
# 사내 npm / PyPI 미러 주소. 비우면 기본 저장소를 쓴다.
NPM_REGISTRY=
PIP_INDEX_URL=

# ═════════════════════════════════════════════════════════════════════
# ai-backend (음성인식 · 외국어 답변 · 상담원 연결) — 아직 쓰지 않으면 이 아래는 모두 비워 둔다.
# 켜는 순서와 결정 사항은 AI_BACKEND.md 를 먼저 확인한다. 값이 비어 있으면 지금과 똑같이 동작한다.
# ═════════════════════════════════════════════════════════════════════
# 챗봇 컨테이너가 ai-backend 로 /v1 일부 경로를 넘길 주소. 켤 때만 http://ai-backend:8100 으로 채운다.
AI_BACKEND_URL=

# 검색(RAG): 벡터 DB, 임베딩 2개, 리랭커
AI_QDRANT_URL=
AI_DENSE_EMBEDDING_URL=
AI_SPARSE_EMBEDDING_URL=
AI_RERANKER_URL=
# 외국어 답변 LLM (OpenAI 호환, 주소 끝은 /v1)
AI_LLM_BASE_URL=
AI_LLM_MODEL=
AI_LLM_API_KEY=
# 한국어 답변 LLM
AI_KO_LLM_BASE_URL=
AI_KO_LLM_MODEL=
AI_KO_LLM_API_KEY=
# 음성인식 (Whisper)
AI_STT_URL=
AI_STT_MODEL=
# 상담원 화면 공용 비밀번호 (비우면 상담원 로그인이 막힘). 따옴표 없이 입력한다
AI_AGENT_PASSWORD=
# 자료에 없는 내용을 물을 때 안내할 대표전화
AI_HOSPITAL_PHONE=
# 상담원 연결 운영시간 (평일만. 이 시간 밖에는 콜백 신청으로 안내)
AI_HANDOFF_OPEN=08:30
AI_HANDOFF_CLOSE=17:30
AI_HANDOFF_HOURS_TEXT=평일 08:30 – 17:30
# 접속자 IP 당 분당 POST 요청 수 (프록시에서 제한. 0 이면 끔)
AI_RATE_LIMIT_PER_MINUTE=20
