# backend/.env 로 복사해서 값을 채우세요. backend/.env 는 Git에 올리지 않습니다 (.gitignore).
# 이미 설정된 환경변수가 있으면 그 값이 우선합니다.

# 상담원 화면 공용 비밀번호 (비워 두면 상담원 로그인 불가)
AGENT_PASSWORD=

# 사내 LLM이 인증을 쓰게 되면 입력 (지금은 비워 둠)
LLM_API_KEY=
KO_LLM_API_KEY=

# 테스트용 — 1이면 운영시간과 관계없이 상담원 연결 가능
HANDOFF_ALWAYS_OPEN=0
# IP당 분당 요청 수 (0이면 제한 끔, 회귀 테스트 때만)
RATE_LIMIT_PER_MINUTE=20

# 사내 서버 주소·모델 이름 (필수 — 저장소에는 적지 않음, 담당자에게 받아 채움)
DENSE_EMBEDDING_URL=
KO_LLM_BASE_URL=
KO_LLM_MODEL=
LLM_BASE_URL=
LLM_MODEL=
QDRANT_URL=
RERANKER_URL=
SPARSE_EMBEDDING_URL=
STT_MODEL=
STT_URL=
QWEN_BASE_URL=
QWEN_MODEL=
# QWEN_* 는 tests/check_translate_search.py 용 (LLM_* 와 같은 값)
